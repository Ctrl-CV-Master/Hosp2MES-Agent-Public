# ===========================================================================
# Hosp2MES-Agent-Public — environment template
# Copy this file to ".env" and fill in real values. ".env" is git-ignored.
# NEVER commit a real API key.
# ===========================================================================

# ---- Mock MES backend -------------------------------------------------------
# SQLite database URL (relative paths resolve next to backend/).
DATABASE_URL=sqlite:///./mes_demo.db

# ---- LLM (DeepSeek-compatible OpenAI-style chat completions) ----------------
# Leave LLM_API_KEY empty to run the agent with the built-in deterministic
# MockLLM (no network / no key required). Set the values below to use a real
# DeepSeek-compatible endpoint.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=deepseek-chat

# ---- Agent runtime ----------------------------------------------------------
# "hosp2mes"  -> full pipeline (planner + memory + verifier + recovery)
# "baseline"  -> classic GUI-agent behaviour (no evidence gate / recovery)
AGENT_MODE=hosp2mes

# "mock"     -> deterministic planner/LLM, no network (CI / local testing)
# "deepseek" -> real LLM calls via LLM_* above
AGENT_LLM_PROVIDER=mock

# Policy mode for --agent hosp2mes (browser mode):
#   "deterministic" -> always the deterministic observation-driven policy
#   "llm"           -> real LLM, fall back to deterministic on failure (per-step provenance)
#   "llm-strict"    -> real LLM ONLY; any LLM failure/parse/invalid action FAILs the task
AGENT_POLICY=deterministic

# Where the agent publishes live trace steps for the Agent Monitor.
# Leave empty to disable live publishing.
AGENT_PUBLISH_URL=

# Backend base URL the agent talks to (used by benchmark runner / CLI).
BACKEND_BASE_URL=http://localhost:8000
